# ── Environment ─────────────────────────────────────────────────────────────
# development = allows PROVIDER=mock for testing
# production  = blocks PROVIDER=mock to avoid accidentally generating mock placeholder videos
APP_ENV=development
# Directory where generated MP4s and clips are saved
# In Railway / Docker with a persistent volume mounted at /data, set VIDEO_DIR=/data/videos
VIDEO_DIR=


# ── Video provider ──────────────────────────────────────────────────────────
# storyboard = free 5-scene video with pan/zoom motion, captions & edge-tts voiceover (default)
# mock       = moving colour test video, no GPU and no key needed
# replicate  = open-source model hosted on replicate.com (needs a token)
# local      = open-source model on your own NVIDIA GPU
PROVIDER=storyboard
# Image provider: pollinations (free default), cloudflare (Workers AI FLUX), or auto
IMAGE_PROVIDER=pollinations


# ── Replicate (PROVIDER=replicate) ─────────────────────────────────────────
# Only needed when PROVIDER=replicate
REPLICATE_API_TOKEN=
# Pick an open-source video model on replicate.com, e.g. owner/model-name
REPLICATE_MODEL=
# Optional: extra settings the model accepts, as JSON
REPLICATE_EXTRA_INPUT={}
# Optional: the model's own name for its duration setting, if it has one
REPLICATE_SECONDS_FIELD=

# ── Local GPU (PROVIDER=local) ──────────────────────────────────────────────
LOCAL_MODEL=Lightricks/LTX-Video

# ── Credits System ──────────────────────────────────────────────────────────
# Set to false for single-user personal use to bypass credit checks and deductions
CREDITS_ENABLED=true

# ── Job queue ───────────────────────────────────────────────────────────────
# Most videos waiting or being made at one time
MAX_ACTIVE_JOBS=5

# ── Sessions (Phase 2) ──────────────────────────────────────────────────────
# A random secret used to sign session cookies — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-secret

# ── LLM Scene Planning ─────────────────────────────────────────────────────
# Priority order:
# 1. ANTHROPIC_API_KEY if configured
# 2. GEMINI_API_KEY (free tier via Google AI Studio) if configured
# 3. Intelligent 5-beat story structure fallback templates
ANTHROPIC_API_KEY=

# Google Gemini API key (Free tier available at https://aistudio.google.com)
# Free tier limits for gemini-3.8-flash: 15 RPM, 1,500 RPD, 1M TPM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Razorpay (Phase 5 — payments) ──────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Razorpay Dashboard > Webhooks, event: order.paid). URL: https://your-domain.com/api/pay/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── Default language shown to new visitors ─────────────────────────────────
DEFAULT_LANG=en

# ── Pollinations Image Service ─────────────────────────────────────────────
# Optional API key from https://pollinations.ai for faster downloads (3s spacing).
# If empty, anonymous mode is used with 50s spacing.
POLLINATIONS_API_KEY=

# ── Production deployment ──────────────────────────────────────────────────
# Set APP_ENV=production above, then ALSO set these:
# Public URL of your site (used in verification / password-reset emails)
APP_BASE_URL=https://your-domain.com
# SMTP for real emails (verify account, reset password). Without it, users cannot reset passwords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
